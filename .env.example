# Copy this file to .env for local development.
# Do not commit real values.

# Runtime posture
APP_ENV=production
NODE_ENV=production
PORT=3000
AUTH_REQUIRED=true
LLM_PROXY_ENDPOINT=/.netlify/functions/llm-proxy
GEMINI_MODEL_ID=gemini-3-flash-preview
GEMINI_STRICT_MODEL=true
FRONTEND_GEMINI_ALLOWED=false
FEATURE_PWA=true
FEATURE_SENSORS=true

# Integrity and reproducibility
INTEGRITY_THREAT_MODEL=C1
INTEGRITY_HMAC_SECRET=replace_with_random_secret
QICN_SEED=17057
COGNITIVE_EMERGENCE_EVAL_SEED=17057
SEED=17057
RENDER_DETERMINISTIC=true

# LLM / provider secrets
GEMINI_API_KEY=replace_with_real_key
OPENAI_API_KEY=replace_with_real_key

# Quantum entropy
QUANTUM_ENTROPY_ENABLED=false
QUANTUM_ENTROPY_ENDPOINT=/.netlify/functions/quantum-entropy
QUANTUM_PROVIDER_DEFAULT=custom
QUANTUM_ENTROPY_TTL_MS=60000
QUANTUM_POLL_INTERVAL_MS=10000
QUANTUM_REQUIRED_QUALITY_MIN=0.2
QUANTUM_BUFFER_CAPACITY_CHUNKS=8
QUANTUM_BUFFER_LOW_WATERMARK_CHUNKS=2
QUANTUM_BUFFER_REFILL_TARGET_CHUNKS=6
QUANTUM_PROVIDER_TIMEOUT_MS=4500
QUANTUM_PROVIDER_RETRY_COUNT=1
QUANTUM_PROVIDER_RETRY_BACKOFF_MS=300
QUANTUM_PROVIDER_FALLBACK_ENABLED=true
QUANTUM_LOG_LEVEL=warn
QUANTUM_EXPERIMENT_CONDITION=baseline
QUANTUM_EXPERIMENT_SEED=17057
QUANTUM_EXPERIMENT_DELAY_MS=0
QUANTUM_EXPERIMENT_DROPOUT_RATE=0
QUANTUM_EXPERIMENT_REPLAY_SOURCE_ID=
QUANTUM_EXPERIMENT_REPLAY_SEQUENCE=
QUANTUM_SHOTS_DEFAULT=1024
IBM_QUANTUM_API_KEY=replace_with_real_key
IBM_QUANTUM_ENDPOINT=
IBM_QUANTUM_MODE=auto
IBM_QUANTUM_SUBMIT_ENDPOINT=
IBM_QUANTUM_STATUS_ENDPOINT=
IBM_QUANTUM_QUEUE_SUBMIT_ENDPOINT=
IBM_QUANTUM_QUEUE_STATUS_ENDPOINT=
IBM_QUANTUM_QUEUE_JOB_ID_PATH=jobId
IBM_QUANTUM_QUEUE_DONE_PATH=status
IBM_QUANTUM_QUEUE_DONE_VALUES=done,completed,succeeded,success,finished
IBM_QUANTUM_QUEUE_RESULT_PATH=sample
IBM_QUANTUM_QUEUE_POLL_COOLDOWN_MS=1200

# Selfpatch and governance
SELF_PATCH_ENABLED=false
SELF_PATCH_MODE=semi_auto
SELF_PATCH_CODE_PROVIDER=openai
SELF_PATCH_CODE_MODEL=gpt-5.3-codex
SELF_PATCH_CODE_MODEL_FALLBACK=
SELF_PATCH_CODE_REASONING_EFFORT=high
SELF_PATCH_GENERATION_DRY_RUN=true
SELF_PATCH_APPLY_DRY_RUN=true
SELF_PATCH_LOCAL_APPLY=false
SELF_PATCH_AUTORUN_ENABLED=false
SELF_PATCH_AUTORUN_INTERVAL_MS=120000
SELF_PATCH_AUTORUN_REQUIRE_SIM_RUNNING=false
SELF_PATCH_ENABLE_AUTO_MERGE=false
ALLOW_CLIENT_CODEX_KEY=false
QICN_KILLSWITCH=OFF
QICN_BLOB_KILLSWITCH_URL=
QICN_BLOB_KILLSWITCH_STATE=OFF
QICN_NETLIFY_ROLLBACK_MODE=ui_only
QICN_PATCH_MAX_PROPOSALS_24H=3
QICN_PATCH_MAX_INFLIGHT=1
QICN_PATCH_COOLDOWN_MIN=120
QICN_PATCH_TOKEN_BUDGET_DAY=100000

# Deploy-time repository integration
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_SELFPATCH_TOKEN=
NETLIFY_SITE_ID=
NETLIFY_TOKEN=
NETLIFY_ROLLBACK_TOKEN=

# Runtime tuning
PMIA_POST_ASC_NEGATIVE_BIAS=true
PMIA_POST_ASC_NEGATIVE_DUTY=0.78
PMIA_POST_ASC_NEGATIVE_CYCLE_TICKS=36
BUILD_MODE=
