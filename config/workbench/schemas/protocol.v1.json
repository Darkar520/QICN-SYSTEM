{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "qicn.workbench_protocol.v1",
  "required": [
    "schema",
    "digest",
    "evidence_scope",
    "external_support_certified",
    "profile",
    "ticks",
    "inputTape",
    "branches"
  ],
  "properties": {
    "schema": {
      "const": "qicn.workbench_protocol.v1"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_scope": {
      "const": "internal_support_only"
    },
    "external_support_certified": {
      "const": false
    },
    "profile": {
      "enum": [
        "legacy_compatibility",
        "paired_intervention"
      ]
    },
    "ticks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "inputTape": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "perception"
        ],
        "properties": {
          "perception": {
            "type": "object"
          },
          "entropyValue": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "intervention"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "intervention": {
            "enum": [
              "sham",
              "block_history_read",
              "suspend_consolidation",
              "freeze_predictor_weights",
              "erase_declared_history",
              "sensor_impulse"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
