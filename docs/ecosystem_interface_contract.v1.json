{
  "artifact_role": "ecosystem_interface_contract",
  "schema_version": "1.0.0",
  "repositories": {
    "qicn_system": {
      "name": "QICN-SYSTEM",
      "workspace_relative_path": ".",
      "purpose": "operational runtime, governed outputs, enforcement surfaces, internal release bundle",
      "source_of_truth": [
        "docs/REPRODUCIBILITY_CONTRACT.md",
        "docs/OPERATIONAL_READINESS.md",
        "docs/RELEASE_PROCESS.md",
        "artifacts/operational_readiness_manifest.json",
        "artifacts/artifact_manifest.json"
      ]
    },
    "qicn_release": {
      "name": "QICN-RELEASE",
      "repository_locator": {
        "preferred_sibling_dir": "QICN-RELEASE",
        "accepted_sibling_dirs": [
          "QICN-RELEASE",
          "QUICN-RELEASE",
          "release_repo_qicn_2026-03-01"
        ],
        "environment_override": "ECO_RELEASE_ROOT"
      },
      "purpose": "canonical theoretical corpus, freeze governance, claim registry, canonical release bundle",
      "source_of_truth": [
        "QICN-RELEASE/docs/CANON_SOURCE_OF_TRUTH.md",
        "QICN-RELEASE/docs/CLAIM_REGISTRY.md",
        "QICN-RELEASE/docs/LAYER_BOUNDARIES.md",
        "QICN-RELEASE/release/release_freeze_manifest.json",
        "QICN-RELEASE/release/claim_registry.v1.json"
      ]
    }
  },
  "allowed_bridges": [
    {
      "id": "protocol_runtime_governance",
      "release_scope": "QICN v4.5 operational protocol",
      "system_scope": "admissibility, baselines, artifact traceability, bounded support gating",
      "bridge_type": "implementation_linked_not_confirmatory"
    },
    {
      "id": "roeo_operational_export",
      "release_scope": "ROEO annexes",
      "system_scope": "operational export/report surfaces",
      "bridge_type": "operational_annex_only"
    },
    {
      "id": "non_claim_governance_alignment",
      "release_scope": "glossary and methods governance documents",
      "system_scope": "support labels, consumption policy, surface policy, controlled statements",
      "bridge_type": "semantic_governance_alignment_only"
    }
  ],
  "prohibited_inferences": [
    "runtime_metrics_imply_core_theorem_validity",
    "support_labels_imply_framework_confirmation",
    "controlled_statements_imply_external_validation",
    "canonical_freeze_implies_runtime_validation",
    "formal_theorem_implies_current_runtime_instantiation",
    "operational_annex_implies_primary_source_of_truth",
    "derived_lineage_material_implies_primary_source_of_truth"
  ],
  "implementation_linked_not_confirmatory_claim_families": [
    "paper4.qicn_v45_protocol",
    "annex.roeo_export",
    "governance.non_claim_alignment"
  ],
  "non_claim_boundary": "This contract defines allowed internal bridges and blocked cross-repo inferences. It does not validate the corpus, validate the runtime, or authorize claim closure."
}
