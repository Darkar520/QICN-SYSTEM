{
  "artifact_role": "successive_campaign_discipline",
  "schema_version": "1.0.0",
  "successive_campaign_allowed": [
    "ecosystem_candidate_status_pass",
    "repos_clean_and_pushed",
    "frozen_evaluation_architecture_unchanged",
    "runner_executed_campaign_plan_present",
    "canonical_condition_set_preserved",
    "claim_facing_block_preserved"
  ],
  "successive_campaign_requires_fresh_verification": [
    "verify_evaluation_protocol",
    "verify_evaluation_metrics",
    "verify_evaluation_comparisons",
    "verify_evaluation_phase",
    "verify_ecosystem_integrity"
  ],
  "successive_campaign_breaks_baseline": [
    "protocol_drift",
    "comparison_matrix_drift",
    "metrics_registry_drift",
    "controls_registry_drift",
    "statistical_policy_drift",
    "repo_baseline_drift",
    "runtime_semantic_drift",
    "unsupported_comparisons_emitted",
    "claim_facing_block_not_enforced"
  ],
  "exploratory_campaign_not_comparable": [
    "added_or_substituted_conditions",
    "changed_seed_policy",
    "changed_exclusion_logic",
    "changed_required_artifacts",
    "changed_statistical_policy",
    "campaign_outside_frozen_candidate_baseline"
  ],
  "campaign_classes": {
    "comparable_campaign": [
      "same_frozen_architecture",
      "same_condition_set",
      "same_exclusion_policy",
      "same_comparison_matrix",
      "same_or_larger_n"
    ],
    "exploratory_campaign": [
      "internal_only",
      "not_directly_extendable_to_frozen_baseline"
    ],
    "invalid_campaign": [
      "manual_stitching",
      "missing_authoritative_artifacts",
      "candidate_not_pass",
      "claim_facing_leak",
      "unsupported_comparisons_emitted"
    ]
  },
  "internal_only_outputs": [
    "run_evaluation_metrics.json",
    "condition_evaluation_summary.json",
    "condition_comparison_report.json",
    "evaluation_protocol_manifest.json",
    "evaluation_batch_report.json",
    "campaign_execution_plan.json",
    "execution_campaign_readout.json",
    "execution_campaign_audit_readout.json",
    "latest_campaign_pointer.json"
  ],
  "blocked_inferences": [
    "external_validation",
    "theory_confirmation",
    "claim_closure",
    "framework_validation",
    "causal_proof",
    "corpus_validation_from_runtime",
    "automatic_promotion_from_contrast_to_claim",
    "public_release_readiness"
  ],
  "interpretation_boundary": "Successive campaign discipline only; repeated internal campaigns may extend comparability inside the frozen protocol, but they do not authorize stronger semantic claims."
}
