{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "comparative_program_manifest.v1",
  "type": "object",
  "required": [
    "artifact_role",
    "artifact_name",
    "artifact_version",
    "schema_version",
    "comparative_layer_id",
    "layer_version",
    "estimator_version",
    "implementation_status",
    "program_status",
    "authority_status",
    "upstream_refs",
    "governance_refs",
    "artifact_inventory",
    "status_notes",
    "blocked_surface_notes",
    "current_states",
    "boundary_flags",
    "non_implications",
    "source_shas",
    "lineage",
    "interpretation_boundary",
    "provenance",
    "schema_ref"
  ],
  "properties": {
    "artifact_role": { "const": "comparative_program_manifest" },
    "artifact_name": { "const": "comparative_program_manifest.json" },
    "artifact_version": { "type": "string" },
    "schema_version": { "type": "string" },
    "comparative_layer_id": { "type": "string" },
    "layer_version": { "type": "string" },
    "estimator_version": { "type": "string" },
    "implementation_status": { "type": "string" },
    "program_status": { "type": "string" },
    "authority_status": { "type": "string" },
    "upstream_refs": { "type": "object" },
    "governance_refs": { "type": "object" },
    "artifact_inventory": { "type": "object" },
    "status_notes": { "type": "array", "items": { "type": "string" } },
    "blocked_surface_notes": { "type": "array", "items": { "type": "string" } },
    "current_states": { "type": "object" },
    "boundary_flags": { "type": "object" },
    "non_implications": { "type": "array", "items": { "type": "string" } },
    "source_shas": { "type": "object" },
    "lineage": { "type": "object" },
    "interpretation_boundary": { "type": "string" },
    "provenance": { "type": "object" },
    "schema_ref": { "type": "string" }
  }
}
