{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bridge_intervention_profile.v1",
  "type": "object",
  "required": [
    "artifact_role",
    "artifact_name",
    "artifact_version",
    "schema_version",
    "bridge_layer_id",
    "implementation_status",
    "runtime_status",
    "baseline_reference",
    "implemented_interventions",
    "implemented_negative_controls",
    "intervention_runs",
    "negative_control_runs",
    "targeted_bridge_drop",
    "collateral_damage",
    "intervention_selectivity",
    "confound_flags",
    "profile_status",
    "warnings",
    "comparison_readiness",
    "boundary_flags",
    "non_implications",
    "allowed_surfaces",
    "blocked_surfaces",
    "interpretation_boundary",
    "provenance",
    "schema_ref"
  ],
  "properties": {
    "artifact_role": { "const": "bridge_intervention_profile" },
    "artifact_name": { "const": "bridge_intervention_profile.json" },
    "artifact_version": { "type": "string" },
    "schema_version": { "type": "string" },
    "bridge_layer_id": { "const": "phenomenal_bridge_formal_layer.bpfm2" },
    "implementation_status": { "const": "bpfm2_adversarial_pre_gate" },
    "runtime_status": { "type": "string" },
    "baseline_reference": { "type": "object" },
    "implemented_interventions": { "type": "array", "items": { "type": "string" } },
    "implemented_negative_controls": { "type": "array", "items": { "type": "string" } },
    "intervention_runs": { "type": "array", "items": { "type": "object" } },
    "negative_control_runs": { "type": "array", "items": { "type": "object" } },
    "targeted_bridge_drop": { "type": "number", "minimum": 0, "maximum": 1 },
    "collateral_damage": { "type": "number", "minimum": 0, "maximum": 1 },
    "intervention_selectivity": { "type": "number", "minimum": 0, "maximum": 1 },
    "confound_flags": { "type": "array", "items": { "type": "string" } },
    "profile_status": { "type": "string" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "comparison_readiness": { "type": "boolean" },
    "boundary_flags": { "type": "object" },
    "non_implications": { "type": "array", "items": { "type": "string" } },
    "allowed_surfaces": { "type": "array", "items": { "type": "string" } },
    "blocked_surfaces": { "type": "array", "items": { "type": "string" } },
    "interpretation_boundary": { "type": "string" },
    "provenance": { "type": "object" },
    "schema_ref": {
      "const": "src/phenomenal_bridge/schemas/bridge_intervention_profile.v1.json"
    }
  }
}
