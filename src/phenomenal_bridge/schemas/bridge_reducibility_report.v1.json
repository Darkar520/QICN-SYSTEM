{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bridge_reducibility_report.v1",
  "type": "object",
  "required": [
    "artifact_role",
    "artifact_name",
    "artifact_version",
    "schema_version",
    "bridge_layer_id",
    "implementation_status",
    "runtime_status",
    "baseline_bridge_bundle_reference",
    "bridge_intervention_profile_reference",
    "implemented_rivals",
    "implemented_composite_scope",
    "implemented_loss_family",
    "strong_model_loss",
    "best_weak_rival",
    "best_weak_rival_loss",
    "best_bridge_composite",
    "best_bridge_composite_loss",
    "bridge_irreducibility_margin",
    "comparison_supported",
    "classification",
    "warnings",
    "boundary_flags",
    "non_implications",
    "allowed_surfaces",
    "blocked_surfaces",
    "interpretation_boundary",
    "provenance",
    "schema_ref"
  ],
  "properties": {
    "artifact_role": { "const": "bridge_reducibility_report" },
    "artifact_name": { "const": "bridge_reducibility_report.json" },
    "artifact_version": { "type": "string" },
    "schema_version": { "type": "string" },
    "bridge_layer_id": { "const": "phenomenal_bridge_formal_layer.bpfm2" },
    "implementation_status": { "const": "bpfm2_adversarial_pre_gate" },
    "runtime_status": { "type": "string" },
    "baseline_bridge_bundle_reference": { "type": "object" },
    "bridge_intervention_profile_reference": { "type": "object" },
    "implemented_rivals": { "type": "array", "items": { "type": "string" } },
    "implemented_composite_scope": { "type": "string" },
    "implemented_loss_family": { "type": "object" },
    "strong_model_loss": { "type": "object" },
    "best_weak_rival": { "type": "object" },
    "best_weak_rival_loss": { "type": ["number", "null"] },
    "best_bridge_composite": { "type": "object" },
    "best_bridge_composite_loss": { "type": ["number", "null"] },
    "bridge_irreducibility_margin": { "type": "number" },
    "comparison_supported": { "type": "boolean" },
    "classification": { "type": "string" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "boundary_flags": { "type": "object" },
    "non_implications": { "type": "array", "items": { "type": "string" } },
    "allowed_surfaces": { "type": "array", "items": { "type": "string" } },
    "blocked_surfaces": { "type": "array", "items": { "type": "string" } },
    "interpretation_boundary": { "type": "string" },
    "provenance": { "type": "object" },
    "schema_ref": {
      "const": "src/phenomenal_bridge/schemas/bridge_reducibility_report.v1.json"
    }
  }
}
