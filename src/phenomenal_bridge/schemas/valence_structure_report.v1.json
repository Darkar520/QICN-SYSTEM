{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "valence_structure_report.v1",
  "type": "object",
  "required": [
    "artifact_role",
    "artifact_name",
    "artifact_version",
    "schema_version",
    "layer_version",
    "paper_source",
    "runtime_status",
    "run_id",
    "predicate_id",
    "predicate_name",
    "runtime_surface",
    "bridge_role",
    "artifact_class",
    "level",
    "authoritative_status",
    "estimator_status",
    "provisional_estimate",
    "component_scores",
    "transformation_logic",
    "upstream_dependencies",
    "fields_used",
    "bridge_specific_structure",
    "uncertainty_markers",
    "warnings",
    "collapse_risks",
    "collapse_status",
    "boundary_flags",
    "non_implications",
    "allowed_surfaces",
    "blocked_surfaces",
    "implementation_status",
    "interpretation_boundary",
    "provenance",
    "schema_ref"
  ],
  "properties": {
    "artifact_role": { "const": "valence_structure_report" },
    "artifact_name": { "const": "valence_structure_report.json" },
    "artifact_version": { "type": "string" },
    "schema_version": { "type": "string" },
    "layer_version": { "type": "string" },
    "paper_source": { "type": "object" },
    "runtime_status": { "type": "string" },
    "run_id": { "type": "string" },
    "predicate_id": { "const": "Pi_V" },
    "predicate_name": { "const": "valence_structure" },
    "runtime_surface": { "type": "string" },
    "bridge_role": { "type": "string" },
    "artifact_class": { "const": "primary_report" },
    "level": { "const": "run_level_report" },
    "authoritative_status": { "type": "string" },
    "estimator_status": { "const": "provisional_runtime_bridge_estimator" },
    "provisional_estimate": { "type": "number", "minimum": 0, "maximum": 1 },
    "component_scores": { "type": "object" },
    "transformation_logic": { "type": "object" },
    "upstream_dependencies": { "type": "array", "items": { "type": "object" } },
    "fields_used": { "type": "array", "items": { "type": "string" } },
    "bridge_specific_structure": { "type": "object" },
    "uncertainty_markers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "collapse_risks": { "type": "array", "items": { "type": "string" } },
    "collapse_status": { "type": "string" },
    "boundary_flags": { "type": "object" },
    "non_implications": { "type": "array", "items": { "type": "string" } },
    "allowed_surfaces": { "type": "array", "items": { "type": "string" } },
    "blocked_surfaces": { "type": "array", "items": { "type": "string" } },
    "implementation_status": { "const": "bpf1_surface_only" },
    "interpretation_boundary": { "type": "string" },
    "provenance": { "type": "object" },
    "schema_ref": { "const": "src/phenomenal_bridge/schemas/valence_structure_report.v1.json" }
  }
}
