{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ownership_attribution_report.v1",
  "type": "object",
  "required": [
    "artifact_role",
    "artifact_version",
    "layer_version",
    "paper_source",
    "runtime_status",
    "run_id",
    "self_index_dependency",
    "ownership_entries",
    "ownership_coherence",
    "uncertain_fraction",
    "warnings",
    "interpretation_boundary",
    "provenance",
    "schema_ref"
  ],
  "properties": {
    "artifact_role": { "const": "ownership_attribution_report" },
    "artifact_version": { "type": "string" },
    "layer_version": { "type": "string" },
    "paper_source": { "type": "object" },
    "runtime_status": { "type": "string" },
    "run_id": { "type": "string" },
    "self_index_dependency": { "type": "object" },
    "ownership_entries": { "type": "array", "items": { "type": "object" } },
    "ownership_coherence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertain_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "interpretation_boundary": { "type": "string" },
    "provenance": { "type": "object" },
    "schema_ref": { "const": "src/subjectivity/schemas/ownership_attribution_report.v1.json" }
  }
}
