{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "self_index_state.v1",
  "type": "object",
  "required": [
    "artifact_role",
    "artifact_version",
    "layer_version",
    "paper_source",
    "runtime_status",
    "run_id",
    "selected_index",
    "candidate_indices",
    "candidate_count",
    "ambiguity_flag",
    "supporting_signals",
    "interpretation_boundary",
    "provenance",
    "schema_ref"
  ],
  "properties": {
    "artifact_role": { "const": "self_index_state" },
    "artifact_version": { "type": "string" },
    "layer_version": { "type": "string" },
    "paper_source": { "type": "object" },
    "runtime_status": { "type": "string" },
    "run_id": { "type": "string" },
    "selected_index": { "type": ["string", "null"] },
    "candidate_indices": { "type": "array", "items": { "type": "string" } },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "ambiguity_flag": { "type": "boolean" },
    "supporting_signals": { "type": "array", "items": { "type": "object" } },
    "interpretation_boundary": { "type": "string" },
    "provenance": { "type": "object" },
    "schema_ref": { "const": "src/subjectivity/schemas/self_index_state.v1.json" }
  }
}
