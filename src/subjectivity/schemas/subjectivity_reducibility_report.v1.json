{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subjectivity_reducibility_report.v1",
  "type": "object",
  "required": [
    "artifact_role",
    "artifact_version",
    "layer_version",
    "paper_source",
    "runtime_status",
    "run_id",
    "compared_components",
    "rival_family_used",
    "hybrid_family_used",
    "strong_model_loss",
    "best_weak_rival",
    "best_weak_loss",
    "best_weak_hybrid",
    "best_hybrid_loss",
    "irreducibility_margin",
    "comparison_supported",
    "classification",
    "warnings",
    "interpretation_boundary",
    "provenance",
    "schema_ref"
  ],
  "properties": {
    "artifact_role": { "const": "subjectivity_reducibility_report" },
    "artifact_version": { "type": "string" },
    "layer_version": { "type": "string" },
    "paper_source": { "type": "object" },
    "runtime_status": { "type": "string" },
    "run_id": { "type": "string" },
    "compared_components": { "type": "object" },
    "rival_family_used": { "type": "object" },
    "hybrid_family_used": { "type": "object" },
    "strong_model_loss": { "type": "object" },
    "best_weak_rival": { "type": ["object", "null"] },
    "best_weak_loss": { "type": "number" },
    "best_weak_hybrid": { "type": ["object", "null"] },
    "best_hybrid_loss": { "type": "number" },
    "irreducibility_margin": { "type": "number" },
    "comparison_supported": { "type": "boolean" },
    "classification": { "type": "string" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "interpretation_boundary": { "type": "string" },
    "provenance": { "type": "object" },
    "schema_ref": { "const": "src/subjectivity/schemas/subjectivity_reducibility_report.v1.json" }
  }
}
